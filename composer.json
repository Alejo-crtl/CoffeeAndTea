{
    "name": "coffeeandtea/app",
    "description": "Sistema de gestion y tienda para CoffeeAndtea",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kevin Vega Perez",
            "email": "vegaperezkevinsantiago@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-mbstring": "*",
        "ext-session": "*",
        "ext-json": "*",
        "ext-filter": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/php-compatibility": "^9.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "paragonie/random_compat": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "lint": "parallel-lint --exclude vendor --exclude tests --exclude node_modules .",
        "qa": ["@lint", "@phpstan", "@phpcs", "@test"]
    }
}