# Entorno CoffeeAndtea
# Copia este archivo a .env y completa los valores. Nunca compartas ni publiques .env.

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_BASE_URL=https://tu-dominio.example/
APP_TIEMPO_ESTIMADO_MIN=20
APP_ADMIN_EMAIL=vegaperezkevinsantiago@gmail.com
APP_SESSION_NAME=coffeeandtea
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=Lax
APP_CONFIAR_PROXY=false

# Base de datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CoffeeAndTea
DB_USER=postgres
DB_PASS=CAMBIA_ESTA_CONTRASENA

# Correo en desarrollo: Mailpit (http://localhost:8025) o MAIL_DRIVER=log
# Correo en produccion: Gmail con contrasena de aplicacion (SMTP_ENCRYPTION=tls)
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=none
SMTP_FROM=noreply@coffeeandtea.local
SMTP_FROM_NAME=CoffeeAndtea
SMTP_TIMEOUT=15

# Acceso publico temporal (Cloudflare Tunnel o Tailscale Funnel)
# TUNNEL_URL=https://pedidos-abc.trycloudflare.com
